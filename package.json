{
  "name": "shinkansen-rails",
  "version": "1.1.188",
  "description": "Shinkansen Rails",
  "keywords": [
    "Shinkansen",
    "Rails",
    "Zashiki Karakuri",
    "Zashiki",
    "Karakuri"
  ],
  "main": "./src/index.mjs",
  "type": "module",
  "types": "./index.d.mts",
  "author": {
    "name": "Jonathan Perry for Modern Poacher Limited",
    "email": "modernpoacher@modernpoacher.com",
    "url": "https://modernpoacher.com"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22.23.4"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/modernpoacher/shinkansen-rails.git"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "npm run lint -- --fix",
    "nvm": "bash nvm.sh",
    "prelint": "npm run nvm",
    "prepare": "node husky.mjs",
    "pretest": "npm run nvm",
    "test": "cross-env NODE_ENV=test mocha test --recursive"
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/register": "7.29.7",
    "@sequencemedia/eslint-config-standard": "0.3.2",
    "@sequencemedia/eslint-config-typescript": "0.2.3",
    "@types/babel__register": "^7.17.3",
    "@types/chai": "^5.2.3",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "chai": "^6.3.0",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "eslint": "10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0"
  },
  "imports": {
    "#rails": {
      "require": "./src/index.cjs",
      "import": "./src/index.mjs"
    },
    "#rails/rails": "./src/rails/index.mjs"
  },
  "exports": {
    ".": {
      "require": "./src/index.cjs",
      "import": "./src/index.mjs"
    },
    "./rails": "./src/rails/index.mjs"
  },
  "allowScripts": {
    "core-js@3.51.0": true
  }
}
